# ============================================================================
#  .env.example · modelo de configuração — copie para .env e preencha
#  (o .env real NÃO é versionado; veja .gitignore)
# ============================================================================

# --- IA (Claude) ------------------------------------------------------------
# Chave da API da Anthropic -> https://console.anthropic.com/ (Settings > API Keys)
# OU a chave da Azure/Microsoft Foundry (se usar AZURE_FOUNDRY_ENDPOINT abaixo).
ANTHROPIC_API_KEY=

# Endpoint da Azure/Foundry. Preenchido -> usa Claude na Azure (RAG_MODEL vira o
# nome do DEPLOYMENT). Deixe VAZIO para usar a Anthropic direta.
AZURE_FOUNDRY_ENDPOINT=

# Modelo (ou nome do DEPLOYMENT na Azure). Padrão: Claude Opus 4.8
RAG_MODEL=claude-opus-4-8
# Modelo (deployment) só do monitor estruturado — extração em massa, mais barata
# (ex.: Sonnet 4.6). Vazio = usa o RAG_MODEL.
MONITOR_MODEL=

# --- Pastas -----------------------------------------------------------------
# TODAS são opcionais: deixando em branco, cada uma cai numa subpasta do próprio
# projeto (downloads\, saida\, data\index\, relatorios\, screenshots\).
# Preencha só o que precisar apontar para outro disco ou share.
#
# Onde o download salva os PDFs e o MinerU os lê.
DOERJ_DOWNLOADS_DIR=
# Excel do monitor estruturado (monitoramento_AAAA-MM-DD.xlsx).
DOERJ_RELATORIOS_DIR=
# Saída do MinerU — a que mais cresce (~6 MB por edição). Ver DOERJ_RETENCAO_DIAS.
DOERJ_SAIDA_DIR=
# Índice de busca FTS5 (SQLite).
DOERJ_INDEX_DIR=
# Prints de tela quando o download falha (diagnóstico).
DOERJ_SCREENSHOT_DIR=

# Dias que a saída do MinerU fica em disco (src/limpar.py roda no fim do
# pipeline). O texto já vive no índice; a saída só serve para reindexar sem
# reprocessar o PDF. 0 = nunca apaga.
DOERJ_RETENCAO_DIAS=30

# DPI das miniaturas de conferência (maior = mais nítido)
RENDER_DPI=150

# --- Download do D.O. (Playwright dirige o portal do IOERJ) ------------------
PORTAL_URL=https://portal.ioerj.com.br/
CADERNO_ALVO=Poder Executivo
DOWNLOAD_HEADLESS=true

# --- MinerU (extração) ------------------------------------------------------
MINERU_DEVICE_MODE=cpu
MINERU_METHOD=txt
# Páginas por fatia. Cada fatia é um lote na memória do worker do MinerU.
# Fatias grandes (30) podem pedir ~5,6 GB e derrubar o worker em máquinas com
# pouca RAM livre. Baixe este valor se aparecer "Server disconnected without
# sending a response" no log.
MINERU_SLICE=10

# --- Oracle -----------------------------------------------------------------
# python-oracledb em modo thin (não precisa do Oracle Client).
# Use uma CONTA DE SERVIÇO em produção: com credencial pessoal, o job para quando
# a senha expira e toda gravação fica registrada no nome da pessoa.
# O DSN aceita Easy Connect (host:1521/SERVICE) ou colado de uma URL JDBC.
ORACLE_USER=
ORACLE_PASSWORD=
ORACLE_DSN=host:1521/SERVICE_NAME
# Schema (ex.: COE_IA). Vazio = schema do proprio usuario.
ORACLE_SCHEMA=
# Tabela das exoneracoes/nomeacoes (atos de pessoal).
ORACLE_TABLE=IA0001_IOERJ_RAG_DIARIO_INTELIGENTE_001A
# Palavras-chave dos atos de pessoal: colunas PALAVRA_CHAVE, DATA_INI, DATA_FIM.
# Define O QUE o job procura no D.O. (incluir = INSERT; parar = UPDATE DATA_FIM).
# Se o banco nao responder, o job usa a lista de reserva do codigo.
ORACLE_TABLE_PALAVRAS=IA0001_IOERJ_RAG_DIARIO_INTELIGENTE_001B
# Tabela do monitor estruturado (8 temas numa tabela unica). Vazio = nao grava.
ORACLE_TABLE_MONITOR=IA0001_IOERJ_RAG_DIARIO_INTELIGENTE_002A
# Pre-filtro do monitor: colunas PALAVRA_CHAVE, DATA_INI, DATA_FIM. Decide QUAIS
# paginas vao para a IA (corte de custo). Se o banco nao responder, o job usa a
# lista de reserva do codigo (_KW_RELEVANCIA).
ORACLE_TABLE_FILTRO=IA0001_IOERJ_RAG_DIARIO_INTELIGENTE_002B
# Cadastro dos NOMES MONITORADOS: colunas NOME, FUNCAO, DATA_INI, DATA_FIM.
# E a fonte da verdade da secao 3 (incluir = INSERT; retirar = UPDATE com
# DATA_FIM). Se o banco nao responder, o job usa o monitorados.txt como reserva.
ORACLE_TABLE_MONITORADOS=IA0001_IOERJ_RAG_DIARIO_INTELIGENTE_002N

# --- E-mail do boletim (API corporativa de e-mail) --------------------------
# O envio NAO e mais SMTP: e um POST na mesma API que os sistemas Java chamam
# pelo EmailClient (corpo = EmailRequestDTO, header Authorization: Bearer).
#
# CHAVE-MESTRA. Com false, o passo 7 MONTA as requisicoes e grava
# relatorios\email_<data>.json em vez de chamar a API - da para conferir URL,
# destinatarios e assunto ANTES do primeiro envio de verdade (o boletim em si
# abre no navegador: relatorios\boletim_<data>.html). Vire para true quando
# estiver conferido; nao e preciso mexer em codigo.
EMAIL_ENVIO_ATIVO=false

# API de e-mail: o apps.email.url do lado Java.
# (beta: https://beta-ecorp.fazenda.rj.gov.br/enviarMail/api/v1/email/enviar)
EMAIL_API_URL=
EMAIL_API_TIMEOUT_S=30
# Vai no campo `sistema` do DTO - e como a API identifica quem chamou.
EMAIL_SISTEMA=RAG_DOERJ

# SAO DOIS TOKENS. Este e a credencial de ENTRADA do autorizador (o
# autorizador.token do YAML; claims `aplicacao: AUTORIZADOR-SERVICE`,
# `tipoToken: AUTH`). A API de e-mail NAO o aceita - responde 403 de corpo
# vazio, igual a uma chamada sem header. O token que ela aceita e o que o
# autorizador devolve (tipoToken: ACCESS), e quem faz essa troca a cada envio e
# o proprio codigo. NAO versione o valor real: ele vive so no .env.
AUTORIZADOR_TOKEN=

# Ambiente, o mesmo autorizador.ambiente do YAML: beta | prd. Manda em DUAS
# coisas - qual autorizador vale e se a trava de dominio esta ligada (fora de
# 'prd', so sai e-mail para dominio interno). O padrao 'beta' e o seguro.
AUTORIZADOR_AMBIENTE=beta
# URL do autorizador. Vazio = sai do ambiente acima (as duas constantes do
# AutorizadorClient). So preencha se esse endereco mudar.
AUTORIZADOR_URL=
EMAIL_DOMINIOS_INTERNOS=fazenda.rj.gov.br,redhat.com

# Quem envia e quem recebe. Varios destinatarios: separe por ; ou por ,
# O DTO tem UM destinatario por chamada: o job manda uma requisicao por endereco
# (destinatarios + copia). Nao ha Reply-To - a resposta que o rodape do boletim
# pede volta para o EMAIL_REMETENTE.
EMAIL_REMETENTE=robodoerj@fazenda.rj.gov.br
EMAIL_DESTINATARIOS=svc_sei_auto@fazenda.rj.gov.br
EMAIL_COPIA=
EMAIL_ASSUNTO_PREFIXO=[DOERJ] Monitoramento SEFAZ
