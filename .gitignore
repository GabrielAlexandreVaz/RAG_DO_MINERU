# --- Segredos / configuração local (NUNCA subir) ---
.env

# --- Ambiente virtual ---
.venv/
venv/

# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Runtime instalado por deploy\instalar.bat (pesado, reinstalável) ---
# modelos do MinerU (~413 MB) e navegador do Playwright: ficam dentro do projeto
# para o job não depender do perfil do usuário do Windows (ver config.py).
modelos/
navegadores/
mineru.json

# --- Dados gerados pelo pipeline (não versionar) ---
# PDFs baixados do D.O.
downloads/
# saída do MinerU (markdown + content_list.json + imagens)
saida/
# índice FTS5 e jsons gerados
data/
# logs de execução
logs/
# prints de falha do download
screenshots/
# Excel do monitor estruturado
relatorios/

